{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Studysen",
    "version": "0.1.4",
    "identifier": "fr.studysen.app",
    "build": {
        "devUrl": "http://localhost:8081",
        "beforeBuildCommand": "npm run setup-web && npm run pre-update",
        "frontendDist": "../dist/"
    },
    "app": {
        "withGlobalTauri": true,
        "windows": [
            {
                "title": "Studysen",
                "width": 1280,
                "height": 720,
                "center": true
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "createUpdaterArtifacts": true,
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "windows": {
            "nsis": {
                "installMode": "currentUser",
                "languages": [
                    "French"
                ],
                "installerIcon": "icons/icon.ico"
            }
        }
    },
    "plugins": {
        "updater": {
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFBQzhGRkUwNjkzREM5MzkKUldRNXlUMXA0UC9JR21YWHVxeTNrV2Z5WTNTQ1Y4ZGxXQUNaWVZ4NmdlVitKaUlBV2NCaytyYnQK",
            "endpoints": [
                "https://github.com/appen-isen/studysen-desktop/releases/latest/download/latest.json"
            ],
            "windows": {
                "installMode": "passive"
            }
        }
    }
}