{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "desktop-app",
    "version": "0.1.0",
    "identifier": "fr.isen-orbit.app",
    "build": {
        "devUrl": "http://localhost:8081",
        "beforeBuildCommand": "npm run setup-web && npm run build",
        "frontendDist": "../dist/"
    },
    "app": {
        "withGlobalTauri": true,
        "windows": [
            {
                "title": "ISEN Orbit",
                "width": 1024,
                "height": 600,
                "center": true
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    }
}
